# Copy this file to .streamlit/secrets.toml (local) or paste it into
# Streamlit Cloud -> your app -> Settings -> Secrets.
# NEVER commit secrets.toml to git.
#
# Find your connection string in Supabase:
#   Project Settings -> Database -> Connection string -> URI (use the "Transaction" pooler URI
#   on port 6543 for Streamlit Cloud, or the direct URI on port 5432).
DATABASE_URL = "postgresql://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres"

# Password to unlock Manager mode. If not set, the app falls back to the old
# default that is visible in this public repo - set it!
MANAGER_PASSWORD = "choose-a-strong-password"

# Optional. Only if set does the "wipe database" option appear (manager only).
# Leave it out to make wiping all data impossible from the app.
# RESET_CODE = "long-random-code"
