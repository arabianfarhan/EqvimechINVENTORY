# Copy this file to .streamlit/secrets.toml and fill in your Supabase credentials.
# NEVER commit secrets.toml to git.
#
# Find your connection string in Supabase:
#   Project Settings → Database → Connection string → URI (use the "Transaction" pooler URI
#   on port 6543 for serverless/Streamlit Cloud, or the direct URI on port 5432).

DATABASE_URL = "postgresql://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres"
